{
  "name": "@sepveneto/dnde-agent",
  "type": "module",
  "version": "0.2.2",
  "packageManager": "pnpm@10.33.2",
  "description": "",
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/SepVeneto/dnd-editor"
  },
  "keywords": [],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "default": "./dist/element.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build -c vite.config.dist.ts && node scripts/check-dist.mjs && pnpm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "build:playground": "vite build --outDir dist-playground",
    "preview": "vite preview",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@sepveneto/dnde-core": "workspace: *"
  },
  "devDependencies": {
    "@openai/agents": "^0.19.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "dompurify": "^3.4.17",
    "marked": "^18.1.2",
    "openai": "^7.25.0",
    "typescript": "catalog:",
    "vite": "^6.3.5",
    "vue": "catalog:",
    "zod": "^4.6.5"
  }
}
