{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "outDir": "./dist",
    "noEmit": false
  },
  "include": [
    "src/**/*.ts",
    "env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "playground"
  ]
}
